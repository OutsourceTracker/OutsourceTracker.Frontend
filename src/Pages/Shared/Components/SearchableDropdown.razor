@using System.Collections.Generic
@using System.Threading.Tasks
@typeparam TItem where TItem : class

<div class="mb-3 position-relative">
    <label class="form-label fw-semibold">@Label</label>
    <div class="input-group">
        <input type="text"
               class="form-control form-control-lg"
               @bind="SearchTerm"
               @onfocus="ShowDropdown"
               placeholder="Type to search..." />
    </div>

    @if (IsDropdownVisible && FilteredItems.Any())
    {
        <ul class="list-group position-absolute w-100 shadow border mt-1" style="z-index: 1050; max-height: 320px; overflow-y: auto; border-radius: 8px;">
            @foreach (var item in FilteredItems)
            {
                <li class="list-group-item list-group-item-action"
                    @onclick="() => SelectItem(item)">
                    @DisplayProperty(item)
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Select";
    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public TItem SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem> SelectedItemChanged { get; set; }
    [Parameter] public Func<TItem, string> DisplayProperty { get; set; } = item => item?.ToString() ?? "";
    
    [Inject] private IJSRuntime JS { get; init; } = default!;

    private string SearchTerm = "";
    private bool IsDropdownVisible = false;

    private IEnumerable<TItem> FilteredItems => string.IsNullOrEmpty(SearchTerm)
        ? Items
        : Items.Where(i => DisplayProperty(i).Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task ShowDropdown()
    {
        IsDropdownVisible = true;
        await Task.CompletedTask;
    }

    public async Task SelectItem(TItem item)
    {
        SelectedItem = item;
        SearchTerm = DisplayProperty(item);
        IsDropdownVisible = false;
        await SelectedItemChanged.InvokeAsync(item);
    }
}