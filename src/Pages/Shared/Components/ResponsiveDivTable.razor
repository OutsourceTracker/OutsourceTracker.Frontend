@typeparam TItem
@using System.Linq
@using System.Timers
@implements IDisposable

<div class="modern-table-card card border-0 shadow-lg rounded-4 overflow-hidden mb-5 bg-white">
    
    <!-- Header with Search -->
    <div class="card-header border-0 bg-gradient py-4 px-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            
            <!-- Title -->
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                    <i class="bi bi-table fs-4"></i>
                </div>
                <div>
                    <h4 class="mb-0 fw-semibold text-dark">@Title</h4>
                    <small class="text-muted">
                        @FilteredItems.Count of @(Items?.Count ?? 0) records
                    </small>
                </div>
            </div>

            <!-- Search -->
            <div class="flex-grow-1" style="max-width: 420px;">
                <div class="input-group">
                    <span class="input-group-text border-0 bg-light">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           class="form-control border-0 bg-light shadow-sm"
                           placeholder="Search... (click column header to limit)"
                           @bind="SearchTerm"
                           @bind:after="TriggerDebouncedSearch" />
                    @if (!string.IsNullOrWhiteSpace(SearchTerm))
                    {
                        <button class="btn btn-light border-0" @onclick="ClearSearch">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    }
                </div>
            </div>

            <!-- Create Button -->
            @CreateButtonTemplate
        </div>

        <!-- Active Filter Chips -->
        @if (!string.IsNullOrWhiteSpace(ActiveColumnFilter))
        {
            <div class="mt-3 d-flex gap-2 flex-wrap">
                <div class="badge bg-primary d-flex align-items-center gap-1 fs-6 px-3 py-2">
                    Searching in <strong>@ActiveColumnFilter</strong>
                    <button class="btn-close btn-close-white btn-sm ms-2"
                            style="font-size: 0.65rem;"
                            @onclick="ClearColumnFilter"></button>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAllFilters">
                    <i class="bi bi-x"></i> Clear all
                </button>
            </div>
        }
    </div>

    <div class="table-responsive">
        <div class="div-table">

            <!-- Clickable Header -->
            <div class="div-table-header d-flex align-items-center bg-light border-bottom fw-semibold py-3 px-4 text-uppercase small text-muted tracking-wider">
                @HeaderTemplate
            </div>

            <!-- Content -->
            @if (Items == null)
            {
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                    <p class="text-muted mb-0">Loading records...</p>
                </div>
            }
            else if (!FilteredItems.Any())
            {
                <div class="p-5 text-center">
                    <i class="bi bi-inbox display-4 text-muted mb-3"></i>
                    <h5 class="text-muted">No matching records</h5>
                    <p class="text-muted mb-0">Try a different search term or clear filters.</p>
                </div>
            }
            else
            {
                @foreach (var item in FilteredItems)
                {
                    <div class="div-table-row d-flex align-items-center border-bottom px-4 py-4 hover-row transition-all">
                        @RowTemplate(item)
                    </div>
                }
            }
        </div>
    </div>

    @FooterTemplate
</div>

@code {
    [Parameter] public string Title { get; set; } = "Records";
    [Parameter] public List<TItem>? Items { get; set; }

    [Parameter] public RenderFragment HeaderTemplate { get; set; } = null!;
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = null!;
    [Parameter] public RenderFragment CreateButtonTemplate { get; set; } = null!;
    [Parameter] public RenderFragment? FooterTemplate { get; set; }

    // Search & Filter
    private string _searchTerm = string.Empty;
    private string? ActiveColumnFilter { get; set; }
    private List<TItem> FilteredItems { get; set; } = new();

    private System.Timers.Timer? _debounceTimer;

    private string SearchTerm
    {
        get => _searchTerm;
        set => _searchTerm = value;
    }

    protected override void OnInitialized()
    {
        _debounceTimer = new System.Timers.Timer(300);
        _debounceTimer.Elapsed += async (s, e) => await InvokeAsync(ApplyFilter);
        _debounceTimer.AutoReset = false;
    }

    protected override void OnParametersSet()
    {
        ApplyFilter();
    }

    private void TriggerDebouncedSearch()
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private void ApplyFilter()
    {
        if (Items == null)
        {
            FilteredItems = new();
            return;
        }

        var query = Items.AsQueryable();

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var term = SearchTerm.ToLowerInvariant();

            if (!string.IsNullOrEmpty(ActiveColumnFilter))
            {
                // Column-specific filtering would need a more advanced setup.
                // For now we fall back to default ToString. You can extend later.
                query = query.Where(item =>
                    item!.ToString()!.ToLowerInvariant().Contains(term) == true);
            }
            else
            {
                query = query.Where(item =>
                    item!.ToString()!.ToLowerInvariant().Contains(term) == true);
            }
        }

        FilteredItems = query.ToList();
        StateHasChanged();
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
        ApplyFilter();
    }

    private void ClearColumnFilter()
    {
        ActiveColumnFilter = null;
        ApplyFilter();
    }

    private void ClearAllFilters()
    {
        SearchTerm = string.Empty;
        ActiveColumnFilter = null;
        ApplyFilter();
    }

    public void SetColumnFilter(string columnName)
    {
        ActiveColumnFilter = columnName;
        TriggerDebouncedSearch();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}