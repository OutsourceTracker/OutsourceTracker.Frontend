@page "/accounts/create"
@page "/accounts/edit/{Id:guid?}"
@using OutsourceTracker.BusinessUnit.Accounts
@using OutsourceTracker.BusinessUnit.Divisions
@using OutsourceTracker.Pages.Shared.Components
@using OutsourceTracker.Services
@using OutsourceTracker.Services.DataModels

<PageTitle>@(Id.HasValue ? "Edit" : "Create") Account</PageTitle>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-3">
                    <h4 class="mb-0">@(Id.HasValue ? "Edit Organizational Account" : "New Organizational Account")</h4>
                </div>
                <div class="card-body">
                    <EditForm Model="model" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Short Code <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="model.ShortCode" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="model.Name" />
                        </div>

                        <!-- Searchable Dropdown for Organization Unit -->
                        <SearchableDropdown TItem="OrganizationalUnit"
                                            Label="Organization Unit (OUID)"
                                            Items="organizationUnits"
                                            @bind-SelectedItem="SelectedOrganizationUnit"
                                            DisplayProperty="@(ou => $"{ou.Name} ({ou.ShortCode})")"
                                            @ref="ouDropdown" />

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-success px-5">Save</button>
                            <button type="button" class="btn btn-secondary px-5" @onclick="Cancel">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    [Inject] private AccountService Service { get; init; } = default!;
    [Inject] private OrganizationalUnitService OUService { get; init; } = default!;
    [Inject] private NavigationManager Navigation { get; init; } = default!;

    private SearchableDropdown<OrganizationalUnit> ouDropdown = default!;
    private OrganizationalAccount model = new();

    private List<OrganizationalUnit> organizationUnits = new();

    private OrganizationalUnit? SelectedOrganizationUnit
    {
        get => organizationUnits.FirstOrDefault(ou => ou.Id.ToString() == OUID);
        set
        {
            OUID = value?.Id.ToString();
            model.OUID = value!.Id;
        }
    }

    private string? OUID { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ous = await OUService.Search((object?)null);

        if (ous.Success && ous.Data is List<OrganizationalUnit> ouList)
        {
            organizationUnits = ouList;
        }

        if (Id.HasValue)
        {
            var result = await Service.Get(Id.Value);
            if (result.Success && result.Data is OrganizationalAccount account)
            {
                model = account;
                SelectedOrganizationUnit = organizationUnits.FirstOrDefault(ou => ou.Id == account.OUID);
                await ouDropdown.SelectItem(SelectedOrganizationUnit!);
                StateHasChanged();
            }
        }
    }

    private async Task SaveAsync()
    {
        ModelResult result;
        if (Id.HasValue)
            result = await Service.Update(Id.Value, new
            {
                model.ShortCode,
                model.Name,
                OUID = Guid.Parse(OUID!)
            });
        else
            result = await Service.Create(new
            {
                model.ShortCode,
                model.Name,
                OUID = Guid.Parse(OUID!)
            });


        if (result.Success)
        {
            Navigation.NavigateTo("/accounts");
        }
    }

    private void Cancel() => Navigation.NavigateTo("/accounts");
}