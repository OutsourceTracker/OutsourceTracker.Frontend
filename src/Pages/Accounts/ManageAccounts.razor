@page "/accounts"
@using OutsourceTracker.BusinessUnit.Accounts
@using OutsourceTracker.BusinessUnit.Divisions
@using OutsourceTracker.Models
@using OutsourceTracker.Pages.Shared.Components
@using OutsourceTracker.Services

<PageTitle>Accounts Management</PageTitle>

<div class="container-fluid py-4">
    <ResponsiveDivTable TItem="OrganizationalAccount" Title="Accounts"
                        Items="accounts"
                        @ref="tableRef">

        <CreateButtonTemplate>
            <button class="btn btn-primary btn-lg shadow-sm" @onclick='() => Navigation.NavigateTo("/accounts/create")'>
                <i class="bi bi-plus-circle me-2"></i>New Account
            </button>
        </CreateButtonTemplate>

        <HeaderTemplate>
            <div class="flex-fill" @onclick='() => tableRef?.SetColumnFilter("Name")'>Name</div>
            <div class="flex-fill" @onclick='() => tableRef?.SetColumnFilter("ShortCode")'>Short Code</div>
            <div class="flex-fill" @onclick='() => tableRef?.SetColumnFilter("OU")'>Organizational Unit</div>
            <div class="flex-fill text-end">Actions</div>
        </HeaderTemplate>

        <RowTemplate Context="acc">
            <div class="flex-fill fw-medium">@acc.Name</div>
            <div class="flex-fill">@acc.ShortCode</div>
            <div class="flex-fill">@GetOrganizationalUnitName(acc.OUID)</div>
            <div class="flex-fill text-end">
                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Edit(acc.Id)">
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(acc.Id)">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </RowTemplate>
    </ResponsiveDivTable>
</div>

@code {
    [Inject] NavigationManager Navigation { get; init; } = default!;
    [Inject] IJSRuntime JS { get; init; } = default!;
    [Inject] AccountService Service { get; init; } = default!;
    [Inject] OrganizationalUnitService OUService { get; init; } = default!;

    private List<OrganizationalAccount> accounts = new();
    private List<OrganizationalUnit> organizationalUnits = new();
    private ResponsiveDivTable<OrganizationalAccount> tableRef = default!;

    protected override async Task OnInitializedAsync()
    {
        var result = await Service.Search((object?)null);

        if (result.Success)
        {
            accounts = result.Data as List<OrganizationalAccount> ?? new();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Failed to load accounts.");
        }

        var ouResult = await OUService.Search((object?)null);

        if (ouResult.Success)
        {
            organizationalUnits = ouResult.Data as List<OrganizationalUnit> ?? new();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Failed to load organizational units.");
        }
    }

    private void Edit(Guid id) => Navigation.NavigateTo($"/accounts/edit/{id}");

    private async Task Delete(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this organizational account?"))
            return;

        var result = await Service.Delete(id);

        if (result.Success)
        {
            accounts = accounts?.Where(a => a.Id != id).ToList();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Failed to delete the account.");
        }
    }

    private string GetOrganizationalUnitName(Guid id)
    {
        OrganizationalUnit? organizationalUnit = organizationalUnits.FirstOrDefault(ou => ou.Id == id);
        return organizationalUnit != null ? organizationalUnit.ShortCode : "N/A";
    }
}