@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using OutsourceTracker.Authentication
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@attribute [Authorize]
@inject ITokenService Token

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudGrid Spacing="4" Justify="Justify.FlexStart">
        
        <!-- Hours of Service Card - Top Left, Compact -->
        <MudItem xs="12" md="7" lg="5">
            <MudCard Class="pa-5" Style="box-shadow: 0 8px 32px rgba(0,0,0,0.12); height: 100%;">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">Hours of Service</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Current Status • Updated moments ago</MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent Class="pt-2 pb-4">
                    <MudGrid Spacing="3">
                        <!-- Top Row -->
                        <MudItem xs="6">
                            <!-- Workday -->
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.subtitle2" Class="mb-1 text-center">Workday</MudText>
                                <MudChart T="double" ChartType="ChartType.Donut" Width="110" Height="110"
                                          ChartSeries="@([WorkdaySeries])"
                                          ChartLabels="@Labels" ChartOptions="ChartOptions" />
                                <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold">14/14</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Info">Hours Used</MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="6">
                            <!-- Drive -->
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.subtitle2" Class="mb-1 text-center">Drive</MudText>
                                <MudChart T="double" ChartType="ChartType.Donut" Width="110" Height="110"
                                          ChartSeries="@([DriveSeries])"
                                          ChartLabels="@Labels" ChartOptions="ChartOptions" />
                                <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold">11/11</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Warning">Hours Used</MudText>
                            </div>
                        </MudItem>

                        <!-- Bottom Row -->
                        <MudItem xs="6">
                            <!-- Break -->
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.subtitle2" Class="mb-1 text-center">Break</MudText>
                                <MudChart T="double" ChartType="ChartType.Donut" Width="110" Height="110"
                                          ChartSeries="@([BreakSeries])"
                                          ChartLabels="@Labels" ChartOptions="ChartOptions" />
                                <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold">8/10</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Success">Hours Taken</MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="6">
                            <!-- Cycle -->
                            <div class="d-flex flex-column align-center">
                                <MudText Typo="Typo.subtitle2" Class="mb-1 text-center">Cycle (70/8)</MudText>
                                <MudChart T="double" ChartType="ChartType.Donut" Width="110" Height="110"
                                          ChartSeries="@([CycleSeries])"
                                          ChartLabels="@Labels" ChartOptions="ChartOptions" />
                                <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold">70/100</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">Hours Used</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>

                <MudCardActions Class="justify-center pt-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                        View Full HOS Log
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- User Profile Card -->
        <MudItem xs="12" md="5" lg="7">
            <MudCard Class="pa-8" Style="box-shadow: 0 8px 32px rgba(0,0,0,0.12); height: 100%;">
                @if (User != null)
                {
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="d-flex flex-column align-center">
                                <MudAvatar Size="Size.Large" Class="mb-4" Style="width: 120px; height: 120px; font-size: 3rem;">
                                    AU
                                </MudAvatar>
                                <MudText Typo="Typo.h4" Class="mb-1">@User.Identity!.Name</MudText>
                                <MudText Typo="Typo.body1" Color="Color.Secondary">@User.FindFirst("alphacode")!.Value</MudText>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="pt-0">
                        <MudDivider Class="my-6" />

                        <div class="d-flex flex-column gap-4">
                            <div class="d-flex justify-space-between">
                                <MudText><MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2" /> Email</MudText>
                                <MudText Color="Color.Primary">@User.FindFirst(JwtRegisteredClaimNames.Email)!.Value</MudText>
                            </div>

                            <div class="d-flex justify-space-between">
                                <MudText><MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="mr-2" /> Location</MudText>
                                <MudText>Sumner, WA</MudText>
                            </div>
                        </div>
                    </MudCardContent>

                    <MudCardActions Class="justify-center pt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="px-8">
                            Edit Profile
                        </MudButton>
                    </MudCardActions>
                }
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.caption" Class="text-center mt-8" Color="Color.Warning">
        OutsourceTracker Dashboard • Prototype v0.1
    </MudText>
</MudContainer>

@code
{
    private ClaimsPrincipal? User { get; set; }

    // Chart Data
    private readonly string[] Labels = { "Used", "Remaining" };

    private readonly ChartSeries<double> WorkdaySeries = new ChartSeries<double> { Name = "Workday", Data = new double[] { 14, 6 } };

    private readonly ChartSeries<double> DriveSeries = new ChartSeries<double> { Name = "Drive", Data = new double[] { 11, 3 } };

    private readonly ChartSeries<double> BreakSeries = new ChartSeries<double> { Name = "Break", Data = new double[] { 8, 2 } };

    private readonly ChartSeries<double> CycleSeries = new ChartSeries<double> { Name = "Cycle", Data = new double[] { 70, 30 } };

    private DonutChartOptions ChartOptions = new DonutChartOptions()
    {
        ShowLegend = false,
        ShowValues = false,
        ShowAsPercentage = true,
        ShowToolTips = false
    };

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        string? token = await Token.GetTokenAsync();

        if (string.IsNullOrWhiteSpace(token))
        {
            return;
        }

        ClaimsPrincipal? user = await Token.ValidateTokenAsync(token!);
        User = user;
        StateHasChanged();
    }
}