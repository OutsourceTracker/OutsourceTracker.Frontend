@page "/trailers"
@using OutsourceTracker.Equipment
@using OutsourceTracker.Equipment.Trailers
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Trailers Management</MudText>

    <MudGrid Spacing="4">
        <!-- Left: List -->
        <MudItem xs="12" md="5" Style="height: calc(100vh - 150px); overflow: auto;">
            <MudCard Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Trailer List (@filteredTrailers.Count)</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudTextField @bind-Value="searchTerm"
                                      Placeholder="Search trailers..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true" OnKeyUp="FilterTrailers" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudList T="TrailerModel" Dense="true">
                        @foreach (var trailer in filteredTrailers)
                        {
                            <MudListItem OnClick="() => SelectTrailer(trailer)">
                                <div class="d-flex flex-column">
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body1"><strong>@trailer.FullName</strong></MudText>
                                        <MudChip Color="@GetStatusColor(trailer.State)" Size="Size.Small">@trailer.State</MudChip>
                                    </div>
                                    <MudText Typo="Typo.body2" Color="Color.Primary">@trailer.ZoneName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Last updated: @trailer.CreatedOn.ToLocalTime().ToString("g")</MudText>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Right: Map -->
        <MudItem xs="12" md="7" Style="height: calc(100vh - 150px);">
            <MudCard Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Live Location Map</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-0" Style="height: calc(100% - 60px); position: relative;">
                    <!-- Google Maps Placeholder / Container -->
                    <div id="googleMap"
                         style="width: 100%; height: 100%; background: #e0e0e0; border: 1px solid #ccc; display: flex; align-items: center; justify-content: center;">
                        <div style="text-align: center; color: #666;">
                            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Large" />
                            <p class="mt-2">Google Maps will load here</p>
                            <p class="caption">Markers for all trailers will appear on the map</p>
                        </div>
                    </div>

                    <!-- Future map integration placeholder comment -->
                    <!-- <GoogleMap @ref="_map" ... /> -->
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<TrailerModel> allTrailers = new();
    private List<TrailerModel> filteredTrailers = new();
    private string? searchTerm;
    private TrailerModel? selectedTrailer;

    protected override async Task OnInitializedAsync()
    {
        await LoadTrailers();
    }

    private async Task LoadTrailers()
    {
        try
        {
            allTrailers = new()
            {
                new TrailerModel
                {
                    Id = Guid.NewGuid(),
                    Name = "200146",
                    Prefix = "JBHZ",
                    State = Equipment.EquipmentState.Available,
                    FullName = "JBHZ 200146",
                    ZoneName = "WinCo Yakima"
                },
                new TrailerModel
                {
                    Id = Guid.NewGuid(),
                    Name = "202657",
                    Prefix = "JBHZ",
                    State = Equipment.EquipmentState.Available,
                    FullName = "JBHZ 202657",
                    ZoneName = "WinCo Yakima"
                }
            };
            filteredTrailers = allTrailers.ToList();
        }
        catch (Exception ex)
        {
            // TODO: Add MudSnackbar notification
            Console.WriteLine($"Error loading trailers: {ex.Message}");
        }
    }

    private void SelectTrailer(TrailerModel trailer)
    {
        selectedTrailer = trailer;
        // TODO: Center map on selected trailer when map is implemented
        StateHasChanged();
    }

    private Color GetStatusColor(EquipmentState status) => status switch
    {
        EquipmentState.Available => Color.Success,
        EquipmentState.Dispatched => Color.Secondary,
        EquipmentState.MechanicallyDown => Color.Warning,
        _ => Color.Default
    };

    // Search filter
    private void FilterTrailers()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredTrailers = allTrailers.ToList();
        }
        else
        {
            filteredTrailers = allTrailers
                .Where(t => t.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    // Called via @bind-Value after debounce or on input
    private void OnSearchChanged(string value)
    {
        searchTerm = value;
        FilterTrailers();
    }
}