@page "/trailers-map"
@using System.Net.Http.Json
@using OutsourceTracker.Components.GoogleMaps
@using OutsourceTracker.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject TrailerService Trailers


<PageTitle>Trailer Locator</PageTitle>

<div class="container-fluid py-4">
    <h3 class="mb-4">Trailer Locations Map</h3>

    <!-- Input form – Bootstrap 5 -->
    <div class="card mb-4">
        <div class="card-body">
            <label class="form-label fw-bold">Enter Trailer IDs (comma-separated)</label>
            <textarea @bind="inputTrailerIds" 
                      class="form-control" 
                      rows="3" 
                      placeholder="TRL001, TRL002, TRL005"></textarea>
            <button @onclick="LoadTrailersAsync" 
                    class="btn btn-primary mt-3" 
                    disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Load &amp; Show on Map
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading trailers...</span>
            </div>
        </div>
    }
    else if (trailers.Any())
    {
        <div class="row g-4">
            <!-- Responsive details (div-based, no tables – fits any screen size) -->
            <div class="col-lg-5 col-xl-4">
                <h5 class="mb-3">Basic Details</h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var trailer in trailers)
                    {
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="card-title mb-1">@trailer.Id</h6>
                                        <p class="mb-2">
                                            <span class="badge bg-@(trailer.Status?.ToLower() == "active" ? "success" : "secondary")">
                                                @trailer.Status
                                            </span>
                                        </p>
                                        <p class="mb-1 text-muted small">
                                            Lat: <strong>@trailer.Latitude</strong><br>
                                            Lng: <strong>@trailer.Longitude</strong>
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(trailer.LocationName))
                                        {
                                            <p class="card-text mb-0">@trailer.LocationName</p>
                                        }
                                        @if (trailer.LastSeen.HasValue)
                                        {
                                            <p class="text-muted small mb-0">
                                                Last seen: @trailer.LastSeen.Value.ToString("g")
                                            </p>
                                        }
                                    </div>

                                    <!-- Geo hyperlink button -->
                                    <a href="@($"geo:{trailer.Latitude},{trailer.Longitude}")" 
                                       class="btn btn-success btn-sm d-flex align-items-center gap-1"
                                       target="_blank"
                                       title="Open in native Maps app (Google/Apple)">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        Navigate
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Map (uses existing refactored Google Maps component from zone-maps branch) -->
            <div class="col-lg-7 col-xl-8">
                <h5 class="mb-3">Live Map</h5>
                <div class="border rounded overflow-hidden" style="height: 620px;">
                    <GoogleMaps 
                        Pins="@GetMarkers()"
                        Zoom="11" 
                        Center="@GetCenter()" />
                </div>
                <div class="text-muted small mt-2 text-center">
                    Click markers for details • Geo buttons open native map apps
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(inputTrailerIds))
    {
        <div class="alert alert-info">
            No trailers found for the provided IDs.
        </div>
    }
</div>

@code {
    private string inputTrailerIds = string.Empty;
    private List<TrailerLocation> trailers = new();
    private bool isLoading = false;

    // Replace with actual DTO from OutsourceTracker.Common once you pull latest develop/zone-maps
    public class TrailerLocation
    {
        public string Id { get; set; } = string.Empty;
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string? Status { get; set; }
        public string? LocationName { get; set; }
        public DateTime? LastSeen { get; set; }
    }

    private async Task LoadTrailersAsync()
    {
        if (string.IsNullOrWhiteSpace(inputTrailerIds)) return;

        isLoading = true;
        trailers.Clear();
        StateHasChanged();

        try
        {
            var ids = inputTrailerIds
                .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .ToList();

            // Backend endpoint – add this in Backend if it doesn't exist yet (POST list of IDs)
            var ts = Trailers.Search();
            trailers = new List<TrailerLocation>();
            await foreach (var t in ts)
            {
                if (ids.Any(i => t.FullName.Contains(i, StringComparison.CurrentCultureIgnoreCase)))
                {
                    TrailerLocation location = new() { Id = t.FullName };
                    if (t.LocatedDate.HasValue)
                    {
                        location.LastSeen = t.LocatedDate.Value.LocalDateTime;
                    }

                    if (t.ZoneName != null)
                    {
                        location.LocationName = t.ZoneName;
                    }

                    if (t.Location.HasValue)
                    {
                        location.Latitude = t.Location.Value.X;
                        location.Longitude = t.Location.Value.Y;
                    }

                    location.Status = t.State.ToString();
                    trailers.Add(location);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading trailers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private List<GoogleMaps.MapPin> GetMarkers() => trailers
        .Select(t => new GoogleMaps.MapPin
        {
            Position = new GoogleMaps.LatLng() { Lat = t.Latitude, Lng = t.Longitude },
            Title = t.Id,
            Content = t.Status?.FirstOrDefault().ToString() ?? "T"
        })
        .ToList();

    private GoogleMaps.LatLng GetCenter()
    {
        if (!trailers.Any()) return new GoogleMaps.LatLng { Lat = 47.0, Lng = -122.0 };
        var avgLat = trailers.Average(t => t.Latitude);
        var avgLng = trailers.Average(t => t.Longitude);
        return new GoogleMaps.LatLng { Lat = avgLat, Lng = avgLng };
    }
}