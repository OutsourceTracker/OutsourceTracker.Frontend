@page "/register"
@using System.ComponentModel.DataAnnotations
@using OutsourceTracker.Authentication
@using OutsourceTracker.Services
@layout EmptyLayout
@inject NavigationManager Navigation
@inject UserService Users

<EditForm Model="@model" OnValidSubmit="RegisterAsync">
    <DataAnnotationsValidator />

    <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-8 fw-bold text-primary">Create Account</MudText>

    <MudTextField T="string" @bind-Value="model.Email" Label="Email Address" Variant="Variant.Outlined"
                  Class="mb-6" Immediate="true" autocomplete="email" For="() => model.Email" />

    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="model.FirstName" Label="First Name" Variant="Variant.Outlined"
                          Immediate="true" Class="mb-3" autocomplete="given-name" For="() => model.FirstName" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="model.LastName" Label="Last Name" Variant="Variant.Outlined"
                          Immediate="true" Class="mb-3" autocomplete="family-name" For="() => model.LastName" />
        </MudItem>
    </MudGrid>
    
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="model.AlphaCode" Label="Alpha Code" Variant="Variant.Outlined"
                          Class="mb-3" Immediate="true"
                          OnBlur="HandleAlphaCodeBlur"
                          MaxLength="6" For="() => model.AlphaCode" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="model.WorkdayId" Label="Workday ID" Variant="Variant.Outlined"
                          Class="mb-3" Immediate="true"
                          MaxLength="10" For="() => model.WorkdayId" />
        </MudItem>
    </MudGrid>

    <MudTextField T="string" @bind-Value="model.Password" Label="Password" Variant="Variant.Outlined"
                  InputType="@passwordInput" Adornment="Adornment.End" AdornmentIcon="@passwordIcon"
                  OnAdornmentClick="TogglePasswordVisibility" Class="mb-4" Immediate="true" autocomplete="new-password" For="() => model.Password" />

    <MudTextField T="string" @bind-Value="model.ConfirmPassword" Label="Confirm Password" Variant="Variant.Outlined"
                  InputType="@confirmPasswordInput" Adornment="Adornment.End" AdornmentIcon="@confirmPasswordIcon"
                  OnAdornmentClick="ToggleConfirmPasswordVisibility" Class="mb-8" Immediate="true" autocomplete="new-password" For="() => model.ConfirmPassword" />

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               Size="Size.Large" FullWidth="true" Class="mb-4 rounded-xl" Style="height: 52px;">
        Register
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
               OnClick="GoToLogin" Class="mt-2">
        Already have an account?
    </MudButton>

    <MudDivider Class="my-8" />
</EditForm>

@code {
    private RegisterModel model = new();

    private bool showPassword = false;
    private InputType passwordInput = InputType.Password;
    private string passwordIcon = Icons.Material.Filled.VisibilityOff;

    private bool showConfirmPassword = false;
    private InputType confirmPasswordInput = InputType.Password;
    private string confirmPasswordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
        passwordInput = showPassword ? InputType.Text : InputType.Password;
        passwordIcon = showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
        confirmPasswordInput = showConfirmPassword ? InputType.Text : InputType.Password;
        confirmPasswordIcon = showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private void HandleAlphaCodeBlur()
    {
        if (!string.IsNullOrEmpty(model.AlphaCode))
        {
            model.AlphaCode = model.AlphaCode.ToUpperInvariant();
        }
    }

    private async Task RegisterAsync()
    {
        await Users.RegisterUserAsync(model);
    }

    private void GoToLogin() => Navigation.NavigateTo("/");
}