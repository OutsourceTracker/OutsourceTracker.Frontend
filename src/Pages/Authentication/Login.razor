@page "/"
@using System.ComponentModel.DataAnnotations
@using OutsourceTracker.Authentication
@using OutsourceTracker.Services
@layout EmptyLayout
@inject UserService Users
@inject NavigationManager Navigation

<EditForm Model="@model" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />

    <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-8 fw-bold text-primary">Welcome Back</MudText>
    
    <MudTextField T="string" @bind-Value="model.Email" Label="Email Address" Variant="Variant.Outlined"
                  Class="mb-6" Immediate="true" For="() => model.Email" autocomplete="email" />

    <MudTextField T="string" @bind-Value="model.Password" Label="Password" Variant="Variant.Outlined"
                  InputType="@passwordInput" Adornment="Adornment.End" AdornmentIcon="@passwordIcon"
                  OnAdornmentClick="TogglePasswordVisibility" Class="mb-4" Immediate="true" For="() => model.Password" autocomplete="current-password" />
    
    <div class="d-flex align-center justify-space-between mb-8">
        <MudCheckBox T="bool" @bind-Value="model.RememberMe" Label="Remember me" Color="Color.Primary" />
        <MudLink Href="/forgot-password" Color="Color.Primary">Forgot password?</MudLink>
    </div>

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               Size="Size.Large" FullWidth="true" Class="mb-4 rounded-xl" Style="height: 52px;">
        Sign In
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Secondary" FullWidth="true"
               OnClick="GoToRegister" Class="mt-2">
        Don't have an account?
    </MudButton>

    <MudDivider Class="my-8" />

    <!-- Social logins can be added here later -->
</EditForm>

@code {
    private LoginModel model = new();

    private bool showPassword = false;
    private InputType passwordInput = InputType.Password;
    private string passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
        passwordInput = showPassword ? InputType.Text : InputType.Password;
        passwordIcon = showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await Users.ValidateLogin();
    }

    private async Task LoginAsync() => await Users.LoginAsync(model);

    private void GoToRegister() => Navigation.NavigateTo("/register");
}