@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using OutsourceTracker.Authentication
@layout EmptyLayout
@inject NavigationManager Navigation

@if (!showSuccess)
{
    <EditForm Model="@model" OnValidSubmit="SendResetLinkAsync">
        <DataAnnotationsValidator />

        <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-8 fw-bold text-primary">
            Reset Password
        </MudText>

        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-8 text-secondary">
            Enter your email address and we'll send you a link to reset your password.
        </MudText>

        <MudTextField T="string" @bind-Value="model.Email" Label="Email Address" Variant="Variant.Outlined"
                      Class="mb-8" Immediate="true" For="() => model.Email" autocomplete="email" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" FullWidth="true" Class="mb-4 rounded-xl" Style="height: 52px;">
            Send Reset Link
        </MudButton>

        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                   OnClick="GoToLogin" Class="mt-2">
            Back to Sign In
        </MudButton>
    </EditForm>
}
else
{
    <div class="text-center">
        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Large" Color="Color.Success" Class="mb-6" />
        
        <MudText Typo="Typo.h4" Class="mb-4">Check Your Email</MudText>
        
        <MudText Typo="Typo.body1" Class="mb-8 text-secondary">
            If an account exists with <strong>@model.Email</strong>, you will receive a password reset link shortly.
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" FullWidth="true" Class="rounded-xl mb-4"
                   OnClick="GoToLogin">
            Back to Login
        </MudButton>
    </div>
}

@code {
    private ForgotPasswordModel model = new();
    private bool showSuccess = false;

    private async Task SendResetLinkAsync()
    {
        // If we reach here, validation has already passed
        Console.WriteLine($"Password reset requested for: {model.Email}");

        // TODO: Call AuthService.SendPasswordResetAsync(model.Email)
        showSuccess = true;
    }

    private void GoToLogin() => Navigation.NavigateTo("/");
}