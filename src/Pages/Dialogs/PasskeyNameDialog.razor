@page "/passkey-name-dialog"
@using MudBlazor
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Name this Passkey</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            Give this passkey a friendly name so you can recognize it later (e.g. "iPhone 16", "Work MacBook", "YubiKey").
        </MudText>

        <MudTextField @bind-Value="_name" Label="Passkey Name" Variant="Variant.Outlined" 
                      Placeholder="My Device" AutoFocus="true" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm" Disabled="string.IsNullOrWhiteSpace(_name)">
            Create Passkey
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private string _name = string.Empty;

    private void Confirm()
    {
        MudDialog.Close(DialogResult.Ok(_name.Trim()));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}