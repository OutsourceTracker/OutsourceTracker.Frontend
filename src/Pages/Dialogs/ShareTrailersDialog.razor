@using OutsourceTracker.Equipment.Trailers
@using OutsourceTracker.Services
@inject IJSRuntime JS
@inject ClipboardService Clipboard
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IHttpClientFactory HttpClientFactory

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <DialogContent>
        <MudText Typo="Typo.h6" GutterBottom="true">Share Trailer Locations</MudText>
        
        <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
            @if (Trailers.Count == 1)
            {
                <span>Share location for <strong>@Trailers[0].FullName</strong></span>
            }
            else
            {
                <span>Share locations for <strong>@Trailers.Count</strong> selected trailers</span>
            }
        </MudText>

        <MudList T="string" Dense="true" Class="mb-4">
            @foreach (var trailer in Trailers.Take(5))
            {
                <MudListItem>
                    <MudText Typo="Typo.body2">
                        @trailer.FullName 
                        @if (!string.IsNullOrEmpty(trailer.ZoneName))
                        {
                            <span class="mud-text-secondary">— @trailer.ZoneName</span>
                        }
                        @if (trailer.Location.HasValue)
                        {
                            <span class="mud-text-secondary">(@trailer.Location.Value.X.ToString("F4"), @trailer.Location.Value.Y.ToString("F4"))</span>
                        }
                    </MudText>
                </MudListItem>
            }
            @if (Trailers.Count > 5)
            {
                <MudListItem>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">... and @(Trailers.Count - 5) more</MudText>
                </MudListItem>
            }
        </MudList>

        <MudTextField @bind-Value="emailsInput" 
                      Label="Recipient Emails" 
                      HelperText="Comma or semicolon separated (e.g. user1@ex.com, user2@ex.com)"
                      Class="mb-3" />

        <MudStack Spacing="2">
            <MudButton Variant="Variant.Outlined" 
                       StartIcon="@Icons.Material.Filled.ContentCopy"
                       OnClick="CopyShareTextAsync"
                       FullWidth="true">
                Copy Share Text to Clipboard
            </MudButton>

            <MudButton Variant="Variant.Outlined" 
                       StartIcon="@Icons.Material.Filled.Email"
                       OnClick="ShareViaEmailAsync"
                       FullWidth="true"
                       Disabled="@string.IsNullOrWhiteSpace(emailsInput)">
                Send via Email (backend SendGrid)
            </MudButton>

            <MudButton Variant="Variant.Outlined" 
                       StartIcon="@Icons.Material.Filled.Map"
                       OnClick="ShareViaGeoAsync"
                       FullWidth="true"
                       Disabled="@(!HasLocations)">
                @if (IsLikelyMobile)
                {
                    <span>Share via Maps (geo: protocol)</span>
                }
                else
                {
                    <span>Open in Google Maps</span>
                }
            </MudButton>

            @if (Trailers.Count > 1)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                    Geo: protocol works best for single locations on mobile. Email supports multiple.
                </MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<TrailerModel> Trailers { get; set; } = new();

    private bool HasLocations => Trailers.Any(t => t.Location.HasValue);

    private bool IsLikelyMobile { get; set; } = false;

    private string emailsInput = "";

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        string userAgent = "";
        try
        {
            userAgent = await JS.InvokeAsync<string>("eval", "navigator.userAgent || ''");
            IsLikelyMobile = System.Text.RegularExpressions.Regex.IsMatch(
                userAgent, 
                "Android|iPhone|iPad|iPod|webOS|BlackBerry|IEMobile|Opera Mini", 
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }
        catch
        {
            IsLikelyMobile = false;
        }
        MobilePlatform = DetectPlatform(userAgent);
        await InvokeAsync(StateHasChanged);
    }

    private string MobilePlatform { get; set; } = "unknown";

    private string DetectPlatform(string ua)
    {
        ua = ua.ToLowerInvariant();
        if (ua.Contains("android")) return "android";
        if (ua.Contains("iphone") || ua.Contains("ipad") || ua.Contains("ipod")) return "ios";
        if (ua.Contains("windows phone") || ua.Contains("iemobile")) return "windows";
        if (ua.Contains("blackberry")) return "blackberry";
        return "other";
    }

    private string GenerateShareText()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Trailer Locations:");
        sb.AppendLine();

        foreach (var t in Trailers)
        {
            sb.AppendLine($"- {t.FullName}");
            if (!string.IsNullOrEmpty(t.ZoneName))
            {
                sb.AppendLine($"  Zone: {t.ZoneName}");
            }
            if (t.Location.HasValue)
            {
                var lat = t.Location.Value.X;
                var lng = t.Location.Value.Y;
                sb.AppendLine($"  Coords: {lat:F6}, {lng:F6}");
                sb.AppendLine($"  Directions: https://www.google.com/maps/dir/?api=1&destination={lat:F6},{lng:F6}&travelmode=driving");
            }
            else
            {
                sb.AppendLine("  No location available");
            }
            sb.AppendLine();
        }

        sb.AppendLine("Shared from OutsourceTracker");
        return sb.ToString().Trim();
    }

    private async Task CopyShareTextAsync()
    {
        var text = GenerateShareText();
        await Clipboard.WriteTextAsync(text);
        Snackbar.Add("Share text copied to clipboard", Severity.Success);
        // Optionally close or keep open
    }

    private async Task ShareViaEmailAsync()
    {
        var emails = emailsInput.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(e => e.Trim())
            .Where(e => !string.IsNullOrEmpty(e) && e.Contains('@'))
            .ToList();

        if (!emails.Any())
        {
            Snackbar.Add("Please enter at least one valid email address.", Severity.Warning);
            return;
        }

        var trailersData = Trailers.Select(t => new
        {
            prefix = t.Prefix ?? "",
            name = t.Name ?? "",
            zone = t.ZoneName ?? "N/A",
            coordinates = t.Location.HasValue ? $"{t.Location.Value.X:F4}, {t.Location.Value.Y:F4}" : "N/A",
            lastSpottedBy = t.LocatedByName ?? "System GPS",
            lastSpottedTime = t.LocatedDate.HasValue ? t.LocatedDate.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm") : "N/A",
            googleMapsLink = t.Location.HasValue ? $"https://maps.google.com/?q={t.Location.Value.X},{t.Location.Value.Y}" : ""
        }).ToList();

        var payload = new
        {
            toEmails = emails,
            subject = $"Current Trailer Locations - {DateTime.Now:MMM dd, yyyy}",
            trailers = trailersData
        };

        try
        {
            var http = HttpClientFactory.CreateClient("API_Secured");
            var response = await http.PostAsJsonAsync("trailers/share-locations-email", payload);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Email sent to {emails.Count} recipient(s) via SendGrid.", Severity.Success);
                MudDialog.Close();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to send email: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error sending email: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShareViaGeoAsync()
    {
        if (!HasLocations) return;

        var firstWithLoc = Trailers.FirstOrDefault(t => t.Location.HasValue);
        if (firstWithLoc?.Location == null) return;

        double lat = firstWithLoc.Location.Value.X;
        double lng = firstWithLoc.Location.Value.Y;

        string label = firstWithLoc.FullName ?? "Trailer";
        if (!string.IsNullOrWhiteSpace(firstWithLoc.ZoneName))
            label += $" in {firstWithLoc.ZoneName}";

        string uri;
        if (!IsLikelyMobile)
        {
            // Desktop: web maps link (geo: not supported on desktop)
            uri = $"https://www.google.com/maps/search/?api=1&query={lat:F6},{lng:F6}";
        }
        else
        {
            string escapedLabel = System.Net.WebUtility.UrlEncode(label);
            string uParam = "";
            if (firstWithLoc.LocationAccuracy.HasValue && firstWithLoc.LocationAccuracy.Value > 0)
            {
                // Include accuracy as u= uncertainty parameter (all platforms, but best on Android)
                uParam = $";u={firstWithLoc.LocationAccuracy.Value:F0}";
            }

            // Detailed geo: using lat,lng + u=accuracy (if avail) + q= detailed label (name+zone)
            // This uses all available parameters for the geo: URI
            uri = $"geo:{lat:F6},{lng:F6}{uParam}?q={escapedLabel}";

            // Platform-specific (params are the same detailed set, but noted for support)
            if (MobilePlatform == "ios")
            {
                // iOS: geo:lat,lng;u=acc?q=label  -- q for pin name, u for accuracy info
                uri = $"geo:{lat:F6},{lng:F6}{uParam}?q={escapedLabel}";
            }
            else if (MobilePlatform == "android")
            {
                // Android: full support for ;u= (accuracy circle) + ?q= (labeled marker)
                uri = $"geo:{lat:F6},{lng:F6}{uParam}?q={escapedLabel}";
            }
            // other: standard detailed geo
        }

        try
        {
            await JS.InvokeVoidAsync("window.open", uri, "_blank");
            Snackbar.Add(IsLikelyMobile ? "Opening in maps app..." : "Opening Google Maps...", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not open maps: {ex.Message}", Severity.Error);
        }
    }

    private void Close() => MudDialog.Close();
}