@using OutsourceTracker.BusinessUnit.Accounts
@using OutsourceTracker.Equipment.Trailers
@using OutsourceTracker.Services
@using OutsourceTracker.Services.BusinessUnit.Accounts
@using OutsourceTracker.Services.DataModels
@using OutsourceTracker.Services.Equipment
@inject IEquipmentService<TrailerModel> Trailers
@inject IAccountService AccountsService
@inject ClipboardService Clipboard
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<BulkCreateTrailersDialog> Logger

<MudDialog MaxWidth="MaxWidth.Large" FullWidth="true">
    <DialogContent>
        <MudText Typo="Typo.h6" GutterBottom="true">Add Multiple Trailers</MudText>

        @if (!HasResults)
        {
            <MudText Typo="Typo.body2" Class="mb-2">Add as many trailers as needed. Paste tab-separated data from Excel/Sheets (Prefix, Name, Type, [optional Account shortcode/name]) or click "Add Row". Select a default account below (applies to new rows; can override per-row or use Apply button).</MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.caption">Default account:</MudText>
                <MudSelect T="Guid?" @bind-Value="defaultAccountId"
                           Placeholder="— None —" Clearable="true"
                           ToStringFunc="@(guid => GetAccountDisplayName(guid))"
                           Variant="Variant.Outlined" Dense="true" Style="min-width: 220px;"
                           SearchBox="true" SearchBoxPlaceholder="Search accounts...">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">— None —</MudSelectItem>
                    @foreach (var acc in allAccounts)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)acc.Id)">@acc</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           OnClick="ApplyDefaultToAllRows" Disabled="@(!defaultAccountId.HasValue || items.Count == 0)">
                    Apply to all rows
                </MudButton>
            </MudStack>

            <MudTable Items="@items" Hover="true" Dense="true" Class="mb-4">
                <ToolBarContent>
                    <MudButton OnClick="AddRow" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Outlined">Add Row</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Prefix</MudTh>
                    <MudTh>Name/Number</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Account</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudTextField @bind-Value="context.Prefix" Immediate="true" />
                    </MudTd>
                    <MudTd>
                        <MudTextField @bind-Value="context.Name" Immediate="true" />
                    </MudTd>
                    <MudTd>
                        <MudSelect T="TrailerType" @bind-Value="context.Type" Style="min-width:140px;">
                            <MudSelectItem Value="TrailerType.Van">Dry Van</MudSelectItem>
                            <MudSelectItem Value="TrailerType.Reefer">Reefer</MudSelectItem>
                            <MudSelectItem Value="TrailerType.Flatbed">Flatbed</MudSelectItem>
                            <MudSelectItem Value="TrailerType.Conestoga">Conestoga</MudSelectItem>
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                        <MudSelect T="Guid?" @bind-Value="context.AccountId" Placeholder="—" Clearable="true"
                                   ToStringFunc="@(g => GetAccountDisplayName(g))"
                                   Variant="Variant.Outlined" Dense="true" Style="min-width: 160px;">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">— None —</MudSelectItem>
                            @foreach (var acc in allAccounts)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)acc.Id)">@acc</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => RemoveRow(context)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            @* Results summary after bulk create *@
            <MudText Typo="Typo.body2" Class="mb-2">Bulk create completed.</MudText>

            <MudAlert Severity="Severity.Success" Class="mb-2">
                Successfully created <strong>@BulkResult?.Created.Count</strong> trailer(s).
            </MudAlert>

            @if (BulkResult != null && BulkResult.Failed.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">
                    <strong>@BulkResult.Failed.Count</strong> trailer(s) failed:
                </MudAlert>

                <MudTable Items="@BulkResult.Failed" Dense="true" Hover="true" Class="mb-4">
                    <HeaderContent>
                        <MudTh>Trailer</MudTh>
                        <MudTh>Error</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Key</MudTd>
                        <MudTd>@context.Value</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (!HasResults)
        {
            <MudButton OnClick="Close">Cancel</MudButton>
            <MudButton Color="Color.Primary" OnClick="HandleBulkCreate" Disabled="@(items.Count == 0 || IsProcessing)">
                @if (IsProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Creating...</span>
                }
                else
                {
                    <span>Create @items.Count Trailers</span>
                }
            </MudButton>
        }
        else
        {
            <MudButton OnClick="CloseWithResults" Color="Color.Primary" Variant="Variant.Filled">
                Close
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Optional suggested account ID (e.g. from active filter in parent list). Will be used as default for pasted/added rows.
    /// </summary>
    [Parameter] public Guid? SuggestedAccountId { get; set; }

    private List<TrailerCreateRequest> items = new() { new TrailerCreateRequest() };
    private BulkCreateResult<TrailerModel>? BulkResult;
    private bool IsProcessing = false;

    private List<OrganizationalAccount> allAccounts = new();
    private Dictionary<Guid, OrganizationalAccount> accountLookup = new();
    private Guid? defaultAccountId = null;

    private bool HasResults => BulkResult != null;

    private void AddRow()
    {
        var req = new TrailerCreateRequest();
        if (defaultAccountId.HasValue)
        {
            req.AccountId = defaultAccountId;
        }
        items.Add(req);
    }

    private void RemoveRow(TrailerCreateRequest item)
    {
        if (items.Count > 1)
            items.Remove(item);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await LoadAccounts();

        if (SuggestedAccountId.HasValue && allAccounts.Any(a => a.Id == SuggestedAccountId.Value))
        {
            defaultAccountId = SuggestedAccountId;
            ApplyDefaultToInitialItems();
        }

        await ProcessClipboardData();
    }

    private async Task LoadAccounts()
    {
        try
        {
            allAccounts = await AccountsService.GetAllAsync();
            accountLookup = allAccounts.ToDictionary(a => a.Id);
        }
        catch (Exception ex)
        {
            Logger?.LogWarning(ex, "Failed to load accounts in bulk create dialog.");
            allAccounts = new();
            accountLookup = new();
        }
        StateHasChanged();
    }

    private void ApplyDefaultToInitialItems()
    {
        if (defaultAccountId.HasValue && items.Count > 0)
        {
            foreach (var item in items)
            {
                item.AccountId = defaultAccountId;
            }
        }
    }

    private void ApplyDefaultToAllRows()
    {
        if (!defaultAccountId.HasValue) return;

        foreach (var item in items)
        {
            item.AccountId = defaultAccountId;
        }
        StateHasChanged();
    }

    private string GetAccountDisplayName(Guid? guid)
    {
        if (!guid.HasValue || guid.Value == Guid.Empty)
            return "—";

        if (accountLookup.TryGetValue(guid.Value, out var acc))
        {
            return acc.ToString() ?? acc.Name ?? guid.ToString();
        }

        return guid.Value.ToString();
    }

    private async Task ProcessClipboardData()
    {
        try
        {
            var text = await Clipboard.ReadTextAsync();
            if (string.IsNullOrWhiteSpace(text)) return;

            string[] rows = text.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries);

            List<TrailerCreateRequest> content = new();
            for (int i = 0; i < rows.Length; i++)
            {
                string[] valuesSplit = rows[i].Split('\t', StringSplitOptions.RemoveEmptyEntries);
                if (valuesSplit.Length < 2) continue;

                string prefix = valuesSplit[0].Trim();
                string name = valuesSplit[1].Trim();
                string typeStr = valuesSplit.Length > 2 ? valuesSplit[2].Trim() : "Van";

                // Optional 4th column: account shortcode or name fragment
                Guid? acctId = null;
                if (valuesSplit.Length > 3)
                {
                    string acctStr = valuesSplit[3].Trim();
                    if (!string.IsNullOrWhiteSpace(acctStr))
                    {
                        var match = allAccounts.FirstOrDefault(a =>
                            (a.ShortCode != null && a.ShortCode.Equals(acctStr, StringComparison.OrdinalIgnoreCase)) ||
                            (a.Name != null && a.Name.Contains(acctStr, StringComparison.OrdinalIgnoreCase)) ||
                            a.ToString().Contains(acctStr, StringComparison.OrdinalIgnoreCase));
                        if (match != null)
                            acctId = match.Id;
                    }
                }

                TrailerCreateRequest t = new()
                {
                    Prefix = prefix.ToUpperInvariant(),
                    Name = name.ToUpperInvariant(),
                    Type = Enum.TryParse<TrailerType>(typeStr, true, out var type) ? type : TrailerType.Van,
                    AccountId = acctId ?? defaultAccountId
                };

                // Pad name with leading zeros to 6 chars (existing behavior)
                while (t.Name.Length < 6)
                {
                    t.Name = "0" + t.Name;
                }

                content.Add(t);
            }

            if (content.Count > 0)
            {
                items.Clear();
                items.AddRange(content);
                Snackbar.Add($"Parsed {content.Count} trailers from clipboard", Severity.Success);
                await Clipboard.ClearAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger?.LogDebug(ex, "Clipboard paste for bulk trailers failed or contained no valid data.");
        }
    }

    private async Task HandleBulkCreate()
    {
        if (items.Count == 0 || IsProcessing) return;

        IsProcessing = true;
        StateHasChanged();

        try
        {
            // Filter out obviously empty rows before sending
            var validItems = items
                .Where(i => !string.IsNullOrWhiteSpace(i.Prefix) && !string.IsNullOrWhiteSpace(i.Name))
                .ToList();

            if (validItems.Count == 0)
            {
                Snackbar.Add("No valid trailers to create (Prefix and Name are required).", Severity.Warning);
                return;
            }

            BulkResult = await Trailers.CreateManyAsync(validItems);

            if (BulkResult != null)
            {
                int created = BulkResult.Created.Count;
                int failed = BulkResult.Failed.Count;

                if (created > 0)
                {
                    Snackbar.Add($"Created {created} trailer(s).", Severity.Success);
                }
                if (failed > 0)
                {
                    Snackbar.Add($"{failed} trailer(s) failed to create (see details).", Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("Bulk create request failed unexpectedly.", Severity.Error);
                BulkResult = new BulkCreateResult<TrailerModel>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bulk create failed: {ex.Message}", Severity.Error);
            BulkResult = new BulkCreateResult<TrailerModel>();
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private void CloseWithResults()
    {
        var created = BulkResult?.Created ?? new List<TrailerModel>();
        MudDialog.Close(created);
    }

    private void Close() => MudDialog.Close();
}