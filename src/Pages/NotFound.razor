@page "/404"
@layout EmptyLayout
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h1" Class="error-code mb-4 text-center">
    404
</MudText>

<MudText Typo="Typo.h4" Class="mb-3 fw-medium text-center">
    Lost in Space
</MudText>

<MudText Typo="Typo.body1" Class="mb-8 text-secondary text-center">
    The page you're looking for drifted into another galaxy.
</MudText>

<div class="astronaut-container mb-8 mx-auto" style="width: 180px;">
    <div class="planet"></div>
    <div class="astronaut">👨‍🚀</div>
    <div class="stars"></div>
</div>

<MudStack Row="true" Spacing="2" Justify="Justify.Center">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large"
               Href="/"
               Class="rounded-xl px-8">
        Return Home
    </MudButton>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               Size="Size.Large"
               OnClick="RefreshPage"
               Class="rounded-xl px-8">
        Retry
    </MudButton>
</MudStack>

@code {
    private void RefreshPage()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}