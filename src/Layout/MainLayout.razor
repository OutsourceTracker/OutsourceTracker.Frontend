@using Microsoft.AspNetCore.Components.Authorization
@using OutsourceTracker.Services
@using OutsourceTracker.Services.Authentication
@inherits LayoutComponentBase

<TopNav />

<main class="main flex-grow-1">
    <div class="pt-5 pb-5">
        @if (IsLoggedIn)
        {
            @Body
        }
    </div>
</main>

<footer class="mt-auto py-3 bg-light border-top small text-center text-muted">
    <div class="container">
        Outsource Tracker • © @(DateTime.UtcNow.Year) Vandersluis Trucking
    </div>
</footer>

@code {
    [Inject] private ILogger<MainLayout> Logger { get; init; } = default!;
    [Inject] private IJSRuntime JS { get; init; } = default!;
    [Inject] private AuthenticationStateProvider AuthService { get; init; } = default!;
    [Inject] private NavigationManager Navigation { get; init; } = default!;
    public bool IsLoggedIn { get; private set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsLoggedIn)
        {
            try
            {
                var authState = await AuthService.GetAuthenticationStateAsync();

                if (authState?.User?.Identity?.IsAuthenticated == true)
                {
                    IsLoggedIn = true;
                    Logger.LogDebug("User is authenticated");
                    StateHasChanged();
                }
                else
                {
                    Logger.LogError("User is not authenticated");
                    Navigation.NavigateTo("/login", false);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error checking authentication state");
                Navigation.NavigateTo("/login", true);
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}